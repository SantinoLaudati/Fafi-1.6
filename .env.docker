# Docker Compose Environment Variables
# Copia este archivo a .env en la raiz del proyecto y llena los valores:
#    cp .env.docker .env
# Luego: docker compose up -d --build

# Database
DB_ROOT_PASSWORD=change_me_root_password
DB_PASSWORD=change_me_user_password

# JWT (min 32 caracteres)
JWT_SECRET=change-me-este-jwt-secret-debe-tener-al-menos-32-caracteres

# Domain / URL del juego
# Para la demo escolar usa la IP o hostname del servidor:
#   DOMAIN=192.168.1.100   (sin http://)
#   o DOMAIN=mi-servidor.local
DOMAIN=your-domain.com

# Email (solo para Lets Encrypt/SLL; opcional en la demo)
EMAIL=admin@your-domain.com