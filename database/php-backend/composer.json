{
    "name": "fafi-1.6/php-backend",
    "description": "Fafi-1.6 FPS Multiplayer PHP Backend",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "cboden/ratchet": "^0.4.4",
        "react/socket": "^1.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Fafi\\": "src/"
        },
        "files": [
            "config/db.php",
            "config/jwt.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}