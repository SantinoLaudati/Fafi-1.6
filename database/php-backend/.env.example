# Fafi-1.6 PHP Backend Environment Configuration
# Copy this file to .env and adjust values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=http://your-domain.com

# Database (MySQL)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fafi_1_6
DB_USER=fafi_user
DB_PASSWORD=your_secure_password_here

# For PostgreSQL, use:
# DB_DRIVER=pgsql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=fafi_1_6
# DB_USER=fafi_user
# DB_PASSWORD=your_secure_password_here

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3000
WS_PORT=8080

# CORS (comma-separated domains)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Game settings
TICK_RATE=60
MAX_PLAYERS_PER_ROOM=16